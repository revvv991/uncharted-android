// SPDX-License-Identifier: GPL-2.0-or-later
// g2-arm64: Uncharted 3's GPU skinning compute shader (cs 0c936dd6) for a batch of its
// dispatches at once (vk_skin_batch.cpp): Uncharted 1's algorithm (skin_batch.comp, cs 8f067540)
// without the tangent - one dispatch per character of 1024-thread groups, 93 a frame in the
// Cartagena market at ~8 us each on the G2, the GPU's per-dispatch cost. The game dispatches it ~750 times a frame for a few
// hundred vertices each: on the GPU those ran one after another, each a compute state change for
// one workgroup. Here one workgroup of 64 invocations skins 64 vertices of one dispatch (a
// "job"); the job's buffers come by device address from the job table.
//
// The arithmetic is the translated guest shader's operation for operation, the order of the
// multiplies and adds included. Loads outside a buffer's bound range read zero and stores there
// are dropped, as robust buffer access does for the descriptors of the translated shader.
//
// Guest buffers of a job (the shader's V# order):
//   0  per vertex: influence count, byte offset of its first influence in buffer 3
//   1  position, float3
//   2  normal, half4
//   3  influences: matrix index (bits 22..31), weight (bits 0..21, of 4194303)
//   4  bone matrices, 3x4 rows
//   5  out: position float3, 20-byte vertices
//   6  out: normal half4, 20-byte vertices (the same vertices, 12 bytes in)
//
// g2-arm64 (issue #35): the game binds this shader in more than one layout, and the translated
// shader is compiled for each (a V#'s stride and format): the first one, above, and from U3's
// chapter 16 on, for the meshes with cloth or morph targets, float32 normals (float3)
// in and out - 24-byte output vertices. Without SKIN_ANY_LAYOUT this is the shader of the first
// layout (vk_skin_batch.cpp gives it no other); with it the per-vertex buffers' strides and
// the normal's format come from the job.
#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_spirv_intrinsics : require
#extension GL_KHR_shader_subgroup_ballot : require // g2-arm64 (BB_SKIN_GUARD)

// As the translated shader: 32-bit denormals flushed, signed zeros, infinities and NaNs kept.
spirv_execution_mode(capabilities = [4465], 4460, 32); // DenormFlushToZero
spirv_execution_mode(capabilities = [4466], 4461, 32); // SignedZeroInfNanPreserve

layout(local_size_x = 64) in;

layout(buffer_reference, std430, buffer_reference_align = 4) buffer Dword {
    uint value;
};

struct Job {
    uint64_t address[12]; // guest buffers 0..6 (0: none); the job layout of skin_batch.comp
    uint size[12];        // their bound bytes
    uint stride[12];      // g2-arm64 (issue #35): the per-vertex buffers' strides in dwords
    uint count;           // vertices: min(the guest's vertex count, its invocations)
    uint first_group;     // the job's first workgroup in this dispatch
    uint scale;           // unused here
    uint floats;          // bit i: buffer i's normal or tangent is 32-bit floats, not half4
};

layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer JobTable {
    Job jobs[];
};

layout(buffer_reference, std430, buffer_reference_align = 4) readonly buffer GroupTable {
    uint job_of_group[];
};

// g2-arm64 (BB_SKIN_GUARD=1; the GPU page-fault storms of 2026-11-18 read at garbage addresses
// that look like half-float vertex data): a workgroup whose job index or buffer address is not
// one the CPU can have written skips its job, and the first such job is noted here for the log.
layout(buffer_reference, std430, buffer_reference_align = 8) buffer GuardReport {
    uint count;       // workgroups that skipped their job
    uint batch;       // the first one's batch (push.batch)
    uint job;         // its job index
    uint slot;        // its buffer whose address was outside; 12: the index itself
    uint64_t address; // that address (the index for slot 12)
};

layout(push_constant) uniform Push {
    JobTable job_table;
    GroupTable group_table;
    uint num_groups;
    uint num_jobs;   // g2-arm64 (BB_SKIN_GUARD): the jobs in the table
    uint64_t low;    // the device addresses the port handed out: [low, high)
    uint64_t high;
    uint64_t report; // the GuardReport, 0: no guard
    uint batch;      // the batch's number, for the report
    uint check;      // g2-arm64 (BB_SKIN_GUARD): the CPU's checksum of the above
} push;

uint Load(uint64_t base, uint size, uint dword) {
    if (dword >= (size >> 2u)) {
        return 0u;
    }
    return Dword(base + uint64_t(dword) * 4ul).value;
}

void Store(uint64_t base, uint size, uint dword, uint value) {
    if (dword >= (size >> 2u)) {
        return;
    }
    Dword(base + uint64_t(dword) * 4ul).value = value;
}

float LoadF(uint64_t base, uint size, uint dword) {
    return uintBitsToFloat(Load(base, size, dword));
}

// The workgroup's output vertices for the row stores: 5 dwords each in the first layout, 6 with
// float normals.
#ifdef SKIN_ANY_LAYOUT
shared uint rows_out[64 * 6];
#else
shared uint rows_out[64 * 5];
#endif

// g2-arm64 (BB_SKIN_GUARD): the guard's report buffer, fixed when the pipeline is made, so a
// dispatch whose constants arrive garbage still reports to the right place.
layout(constant_id = 0) const uint REPORT_LO = 0u;
layout(constant_id = 1) const uint REPORT_HI = 0u;
// g2-arm64 (BB_SKIN_GUARD=2): the job's buffer addresses checked too (BuffersSane).
layout(constant_id = 2) const uint GUARD_BUFFERS = 0u;

uint64_t ReportAddress() {
    return (uint64_t(REPORT_HI) << 32) | uint64_t(REPORT_LO);
}

// g2-arm64 (BB_SKIN_GUARD): what the first workgroup whose constants failed their checksum saw,
// 64 bytes into the report buffer: all 14 words, so the log can tell which of them changed.
layout(buffer_reference, std430, buffer_reference_align = 8) buffer PushReport {
    uint count;          // workgroups that found their dispatch's constants changed
    uint check_computed; // the first one's checksum of what it saw
    uint words[14];      // what it saw, in the Push block's order (SkinPush on the CPU)
};

uint MixWord(uint h, uint w) {
    return (h ^ w) * 0x01000193u;
}

// FNV-1a over the 32-bit words of the constants before `check` (SkinPushChecksum on the CPU).
uint PushChecksum() {
    const uint64_t jt = uint64_t(push.job_table);
    const uint64_t gt = uint64_t(push.group_table);
    uint h = 0x811C9DC5u;
    h = MixWord(h, uint(jt));
    h = MixWord(h, uint(jt >> 32));
    h = MixWord(h, uint(gt));
    h = MixWord(h, uint(gt >> 32));
    h = MixWord(h, push.num_groups);
    h = MixWord(h, push.num_jobs);
    h = MixWord(h, uint(push.low));
    h = MixWord(h, uint(push.low >> 32));
    h = MixWord(h, uint(push.high));
    h = MixWord(h, uint(push.high >> 32));
    h = MixWord(h, uint(push.report));
    h = MixWord(h, uint(push.report >> 32));
    h = MixWord(h, push.batch);
    return h;
}

// g2-arm64 (BB_SKIN_GUARD): false, and noted, when the constants are not the ones the CPU pushed
// (checked before anything is read through them).
bool PushSane() {
    if (ReportAddress() == 0ul) {
        return true;
    }
    const uint computed = PushChecksum();
    if (computed == push.check) {
        return true;
    }
    if (gl_LocalInvocationID.x == 0u) {
        PushReport report = PushReport(ReportAddress() + 64ul);
        if (atomicAdd(report.count, 1u) == 0u) {
            const uint64_t jt = uint64_t(push.job_table);
            const uint64_t gt = uint64_t(push.group_table);
            report.check_computed = computed;
            report.words[0] = uint(jt);
            report.words[1] = uint(jt >> 32);
            report.words[2] = uint(gt);
            report.words[3] = uint(gt >> 32);
            report.words[4] = push.num_groups;
            report.words[5] = push.num_jobs;
            report.words[6] = uint(push.low);
            report.words[7] = uint(push.low >> 32);
            report.words[8] = uint(push.high);
            report.words[9] = uint(push.high >> 32);
            report.words[10] = uint(push.report);
            report.words[11] = uint(push.report >> 32);
            report.words[12] = push.batch;
            report.words[13] = push.check;
        }
    }
    return false;
}

// g2-arm64 (BB_SKIN_GUARD): notes a workgroup that skips its job, the first one in full: slot is
// its buffer whose address was outside, 12 the job index itself. Rare, so it reads the address
// to report again.
void NoteJob(uint job_index, uint slot) {
    if (gl_LocalInvocationID.x != 0u) {
        return;
    }
    GuardReport report = GuardReport(ReportAddress());
    if (atomicAdd(report.count, 1u) == 0u) {
        report.batch = push.batch;
        report.job = job_index;
        report.slot = slot;
        report.address =
            slot < 12u ? push.job_table.jobs[job_index].address[slot] : uint64_t(job_index);
    }
}

// g2-arm64 (BB_SKIN_GUARD): false, with the job noted, when the job index is not one of the
// table's (checked before the job is read; uniform in a workgroup: one job each).
bool IndexSane(uint job_index) {
    if (ReportAddress() == 0ul || job_index < push.num_jobs) {
        return true;
    }
    NoteJob(job_index, 12u);
    return false;
}

// g2-arm64 (BB_SKIN_GUARD): whether a buffer of the job is null or inside the device addresses
// handed out, its bound included ([low, high)).
bool InSpan(uint64_t a, uint s) {
    const uint64_t d = a - push.low; // below low it wraps past the span
    const uint64_t span = push.high - push.low;
    return a == 0ul || (d < span && uint64_t(s) <= span - d);
}

// g2-arm64 (BB_SKIN_GUARD): false, with the job noted, when one of the job's n buffers is outside
// the device addresses handed out. The lanes share the work: lane i loads and checks buffer i mod
// n (every subgroup of n lanes or more sees them all and reaches the same verdict), and a ballot
// gathers it. Port 0202 read all 12 slots again in every lane, in a loop that stopped at the
// first bad one: a dozen dependent loads ahead of the job's own, 0.6-0.7 FPS in U1 and U2
// (2026-11-20). ir3's statistics for the A735, the common path of U1's shader: 0202 about 540
// instructions a wave and the loads, the buffers checked in every lane 266, this 63. Even so it
// cost about 0.4 FPS in U1 and never fired outside its test (BB_SKIN_JOB_TEST), so it runs only with
// BB_SKIN_GUARD=2; the default keeps the checksum and the index check (memc-u1-1's catch).
bool BuffersSane(uint job_index, uint n) {
    if (ReportAddress() == 0ul || GUARD_BUFFERS == 0u) {
        return true;
    }
    const uint slot = gl_SubgroupInvocationID % n;
    const uvec4 bad = subgroupBallot(!InSpan(push.job_table.jobs[job_index].address[slot],
                                             push.job_table.jobs[job_index].size[slot]));
    if (bad == uvec4(0u)) {
        return true;
    }
    NoteJob(job_index, subgroupBallotFindLSB(bad) % n);
    return false;
}

void main() {
    if (!PushSane()) {
        return;
    }
    const uint group = gl_WorkGroupID.x;
    if (group >= push.num_groups) {
        return;
    }
    const uint job_index = push.group_table.job_of_group[group];
    if (!IndexSane(job_index)) {
        return;
    }
    const Job job = push.job_table.jobs[job_index];
    const uint local = gl_LocalInvocationID.x;
    const uint vertex = (group - job.first_group) * 64u + local;
    const uint64_t a0 = job.address[0], a1 = job.address[1], a2 = job.address[2];
    const uint64_t a3 = job.address[3], a4 = job.address[4], a5 = job.address[5];
    const uint64_t a6 = job.address[6];
    const uint s0 = job.size[0], s1 = job.size[1], s2 = job.size[2], s3 = job.size[3];
    const uint s4 = job.size[4], s5 = job.size[5], s6 = job.size[6];
    // g2-arm64 (BB_SKIN_GUARD): the buffers this shader uses, 0..6.
    if (!BuffersSane(job_index, 7u)) {
        return;
    }
    // The two output V#s interleave (the normal at +12, the same size): a vertex's outputs are 5
    // consecutive dwords of buffer 5, stored as whole rows through shared memory (skin_batch.comp
    // explains the path; every lane takes part, a lane past the count stores nothing).
#ifdef SKIN_ANY_LAYOUT
    // g2-arm64 (issue #35): the layout from the job - the per-vertex buffers' strides (dwords)
    // and whether the normal is float3 or half4, in and out. Rows as above when the normal's V#
    // starts where the position ends, with one stride of exactly the two.
    const uint d0 = job.stride[0], d1 = job.stride[1], d2 = job.stride[2];
    const uint d5 = job.stride[5], d6 = job.stride[6];
    const bool f2 = (job.floats & (1u << 2u)) != 0u, f6 = (job.floats & (1u << 6u)) != 0u;
    const uint row = f6 ? 6u : 5u;
    const bool rows = d5 == row && d6 == row && a6 == a5 + 12ul && s6 == s5;
#else
    const bool rows = a6 == a5 + 12ul && s6 == s5;
#endif
    if (!rows && !(job.count > vertex)) {
        return;
    }
    const uint gid = rows ? min(vertex, job.count - 1u) : vertex;

#ifdef SKIN_ANY_LAYOUT
    const uint i0 = gid * d0;
    const uint influences = Load(a0, s0, i0);
    const uint first_offset = Load(a0, s0, i0 + 1u);
    const uint i1 = gid * d1;
    const float px = LoadF(a1, s1, i1);
    const float py = LoadF(a1, s1, i1 + 1u);
    const float pz = LoadF(a1, s1, i1 + 2u);
    const uint in2 = gid * d2;
    float nx, ny, nz;
    if (f2) {
        nx = LoadF(a2, s2, in2);
        ny = LoadF(a2, s2, in2 + 1u);
        nz = LoadF(a2, s2, in2 + 2u);
    } else {
        const vec2 n01 = unpackHalf2x16(Load(a2, s2, in2));
        const vec2 n23 = unpackHalf2x16(Load(a2, s2, in2 + 1u));
        nx = n01.x;
        ny = n01.y;
        nz = n23.x;
    }
#else
    const uint i2 = gid * 2u;
    const uint influences = Load(a0, s0, i2);
    const uint first_offset = Load(a0, s0, i2 + 1u);
    const uint i3 = gid * 3u;
    const float px = LoadF(a1, s1, i3);
    const float py = LoadF(a1, s1, i3 + 1u);
    const float pz = LoadF(a1, s1, i3 + 2u);
    const vec2 n01 = unpackHalf2x16(Load(a2, s2, i2));
    const vec2 n23 = unpackHalf2x16(Load(a2, s2, i2 + 1u));
    const float nx = n01.x, ny = n01.y, nz = n23.x;
#endif

    // The first influence's matrix: the position it gives is the base the others add to.
    const uint first = Load(a3, s3, first_offset >> 2u);
    const uint m0 = (first >> 22u) * 48u;
    const uint q0 = m0 >> 2u, q1 = (m0 + 16u) >> 2u, q2 = (m0 + 32u) >> 2u;
    const float b00 = LoadF(a4, s4, q0), b01 = LoadF(a4, s4, q0 + 1u);
    const float b02 = LoadF(a4, s4, q0 + 2u), b03 = LoadF(a4, s4, q0 + 3u);
    const float b10 = LoadF(a4, s4, q1), b11 = LoadF(a4, s4, q1 + 1u);
    const float b12 = LoadF(a4, s4, q1 + 2u), b13 = LoadF(a4, s4, q1 + 3u);
    const float b20 = LoadF(a4, s4, q2), b21 = LoadF(a4, s4, q2 + 1u);
    const float b22 = LoadF(a4, s4, q2 + 2u), b23 = LoadF(a4, s4, q2 + 3u);
    const float p0x = ((b00 * px + b03) + py * b01) + b02 * pz;
    const float p0y = ((b10 * px + b13) + b11 * py) + pz * b12;
    const float p0z = ((px * b20 + b23) + py * b21) + b22 * pz;

    float dpx = 0.0, dpy = 0.0, dpz = 0.0;
    float anx = 0.0, any_ = 0.0, anz = 0.0;
    const float weight_scale = uintBitsToFloat(0x34800002u); // 1 / 4194303
    uint offset = first_offset;
    for (uint i = 0u; i < influences; ++i) {
        const uint packed = Load(a3, s3, offset >> 2u);
        offset += 4u;
        const uint m = (packed >> 22u) * 48u;
        const uint r0 = m >> 2u, r1 = (m + 16u) >> 2u, r2 = (m + 32u) >> 2u;
        const float c00 = LoadF(a4, s4, r0), c01 = LoadF(a4, s4, r0 + 1u);
        const float c02 = LoadF(a4, s4, r0 + 2u), c03 = LoadF(a4, s4, r0 + 3u);
        const float c10 = LoadF(a4, s4, r1), c11 = LoadF(a4, s4, r1 + 1u);
        const float c12 = LoadF(a4, s4, r1 + 2u), c13 = LoadF(a4, s4, r1 + 3u);
        const float weight = weight_scale * float(packed & 0x3FFFFFu);
        const float c20 = LoadF(a4, s4, r2), c21 = LoadF(a4, s4, r2 + 1u);
        const float c22 = LoadF(a4, s4, r2 + 2u), c23 = LoadF(a4, s4, r2 + 3u);
        const float qx = ((px * c00 + c03) + c01 * py) + pz * c02;
        const float qy = ((px * c10 + c13) + c11 * py) + pz * c12;
        const float qz = ((px * c20 + c23) + c21 * py) + pz * c22;
        const float ex = qx - p0x, ey = qy - p0y, ez = qz - p0z;
        const float rnx = (ny * c01 + c00 * nx) + nz * c02;
        const float rny = (ny * c11 + c10 * nx) + nz * c12;
        const float rnz = (ny * c21 + c20 * nx) + nz * c22;
        dpx = ex * weight + dpx;
        dpy = ey * weight + dpy;
        dpz = ez * weight + dpz;
        anx = rnx * weight + anx;
        any_ = rny * weight + any_;
        anz = rnz * weight + anz;
    }

    // Normal: the weighted rotation, normalized.
    const float len2 = (any_ * any_ + anx * anx) + anz * anz;
    const float inv = inversesqrt(len2);
    const float nnx = inv * anx, nny = inv * any_, nnz = inv * anz;
    const float ox = dpx + p0x, oy = dpy + p0y, oz = dpz + p0z;

#ifdef SKIN_ANY_LAYOUT
    if (rows) {
        const uint w = local * row;
        rows_out[w] = floatBitsToUint(ox);
        rows_out[w + 1u] = floatBitsToUint(oy);
        rows_out[w + 2u] = floatBitsToUint(oz);
        if (f6) {
            rows_out[w + 3u] = floatBitsToUint(nnx);
            rows_out[w + 4u] = floatBitsToUint(nny);
            rows_out[w + 5u] = floatBitsToUint(nnz);
        } else {
            rows_out[w + 3u] = packHalf2x16(vec2(nnx, nny));
            rows_out[w + 4u] = packHalf2x16(vec2(nnz, 0.0));
        }
        memoryBarrierShared();
        barrier();
        const uint first_dword = (group - job.first_group) * (64u * row);
        const uint end = min(job.count * row, s5 >> 2u);
        for (uint k = 0u; k < row; ++k) {
            const uint i = local + k * 64u;
            if (first_dword + i < end) {
                Dword(a5 + uint64_t(first_dword + i) * 4ul).value = rows_out[i];
            }
        }
        return;
    }
    const uint o5 = gid * d5, o6 = gid * d6;
    Store(a5, s5, o5, floatBitsToUint(ox));
    Store(a5, s5, o5 + 1u, floatBitsToUint(oy));
    Store(a5, s5, o5 + 2u, floatBitsToUint(oz));
    if (f6) {
        Store(a6, s6, o6, floatBitsToUint(nnx));
        Store(a6, s6, o6 + 1u, floatBitsToUint(nny));
        Store(a6, s6, o6 + 2u, floatBitsToUint(nnz));
    } else {
        Store(a6, s6, o6, packHalf2x16(vec2(nnx, nny)));
        Store(a6, s6, o6 + 1u, packHalf2x16(vec2(nnz, 0.0)));
    }
#else
    const uint o = gid * 5u;
    if (rows) {
        const uint w = local * 5u;
        rows_out[w] = floatBitsToUint(ox);
        rows_out[w + 1u] = floatBitsToUint(oy);
        rows_out[w + 2u] = floatBitsToUint(oz);
        rows_out[w + 3u] = packHalf2x16(vec2(nnx, nny));
        rows_out[w + 4u] = packHalf2x16(vec2(nnz, 0.0));
        memoryBarrierShared();
        barrier();
        const uint first_dword = (group - job.first_group) * (64u * 5u);
        const uint end = min(job.count * 5u, s5 >> 2u);
        for (uint k = 0u; k < 5u; ++k) {
            const uint i = local + k * 64u;
            if (first_dword + i < end) {
                Dword(a5 + uint64_t(first_dword + i) * 4ul).value = rows_out[i];
            }
        }
        return;
    }
    Store(a5, s5, o, floatBitsToUint(ox));
    Store(a5, s5, o + 1u, floatBitsToUint(oy));
    Store(a5, s5, o + 2u, floatBitsToUint(oz));
    Store(a6, s6, o, packHalf2x16(vec2(nnx, nny)));
    Store(a6, s6, o + 1u, packHalf2x16(vec2(nnz, 0.0)));
#endif
}
